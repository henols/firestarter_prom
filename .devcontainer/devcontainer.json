{
  "name": "Firestarter EPROM Programmer",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Privileged + /dev mount needed for serial port access to Arduino hardware.
  // Remove both if you only need to build and not flash/test against hardware.
  "runArgs": ["--privileged"],
  "mounts": [
    "source=/dev,target=/dev,type=bind,consistency=cached"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "ms-python.black-formatter",
        "platformio.platformio-ide"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  },

  "postCreateCommand": "cd /workspaces/firestarter_prom && bash .devcontainer/post-create.sh"
}
