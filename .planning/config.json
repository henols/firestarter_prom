{
  "mode": "YOLO",
  "parallelization": "enabled",
  "granularity": "Comprehensive",
  "workflow": {
    "_auto_chain_active": false,
    "research": true,
    "plan_check": true,
    "verifier": true,
    "code_review": true
  },
  "planning": {
    "sub_repos": [
      "firestarter",
      "firestarter_app",
      "firestarter_app_py32",
      "firestarter_py32_ci"
    ]
  },
  "model_profile": "balanced",
  "model_profile_overrides": {
    "codex": {
      "opus": {
        "model": "gpt-5.6-sol",
        "reasoning_effort": "xhigh"
      },
      "sonnet": {
        "model": "gpt-5.6-terra",
        "reasoning_effort": "medium"
      },
      "haiku": {
        "model": "gpt-5.6-luna",
        "reasoning_effort": "medium"
      }
    }
  },
  "models": {
    "research": "opus"
  },
  "git": {
    "branching_strategy": "milestone",
    "base_branch": "beta",
    "protected_branches": ["main"]
  },
  "graphify": {
    "enabled": true
  }
}
